#version 430 core
// Step 3: copy each boid into its sorted place, so a cell's boids sit side by side.
layout(local_size_x = 256) in;
#include "common.glsl"
void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= uCount) { return; }
  uint j = cellStart[boidCell[i]] + boidRank[i];
  posB[j] = posA[i];
  velB[j] = velA[i];
}
